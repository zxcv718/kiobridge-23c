# 의존성 · 빌드 산출물
node_modules/
dist/
*.tsbuildinfo

# Vercel — .env.local 에 OIDC 토큰이 들어간다. 절대 커밋 금지.
.vercel/
.env
.env.*
!.env.example

# 도구 상태 (개인 환경)
.omc/
**/.omc/
.DS_Store
test-results/
playwright-report/

# 로컬 실행 산출물 (제출 패키지는 submission-output/ 아래에 별도로 보관한다)
workspace/*/output/
.vercel
.env*

# Vercel 식별자 메모 — 손으로 옮겨 적는 용도, 저장소에 올리지 않는다
vercel-ids.txt

# ── KioBridge 키트 (로컬 전용) ────────────────────────────────────────────
# 주최 측이 ZIP 으로 나눠 준 시뮬레이션 키트다. 팀원 모두 이미 갖고 있고,
# 운영진의 갱신 절차도 «새 키트를 별도 폴더에 풀고 참가팀 파일만 옮겨라» 이므로
# 저장소에 둘 이유가 없다.
#
# 예외 셋만 남긴다 — 이것들은 우리 코드가 **컴파일되는 대상**이라 없으면 CI 가
# npm ci 부터 실패한다. @kiobridge/* 는 npm 에 없고(404) 내려받을 주소도 없어
# 저장소에 함께 두는 것 말고 방법이 없다:
#   packages/{contracts,participant-sdk,profile-contract}   — import 25곳
#   environments/chicken-store                              — logic.ts 가 JSON 9개를 직접 읽는다
#
# 나머지(apps·tools·docs·examples·schemas·Docker·실행 스크립트)는 제출물을 만들 때만
# 쓰이고, 그건 로컬 키트에서 하는 일이다.
apps/
docs/
examples/
extensions/
participant-deliverables/
participant-workspace/
schemas/
tools/
/tests/
compose.yaml
Dockerfile
.dockerignore
.devcontainer/
start-*.command
start-*.bat
start-*.sh
stop-*.command
stop-*.bat
stop-*.sh
setup-*.bat
/tsconfig.json
/playwright.config.ts
official-package-manifest.json
00_START_HERE.*
README_FIRST.md
PARTICIPANT_CHECKLIST.md
WINDOWS_FINAL_CHECKLIST.md
FINAL_SUBMISSION_CHECKLIST.md
DO_NOT_EDIT_PLATFORM_FILES.md
workspace/README.md
workspace/.gitkeep
# 아래 여덟은 우리 코드가 컴파일되는 대상이다. package.json 의 dependencies 만 보면
# 셋으로 보이지만, 소스가 서로를 직접 import 한다(워크스페이스라 선언 없이도 되니까).
# 셋만 남겼다가 CI 가 «Cannot find module '@kiobridge/evaluator'» 로 잡았다 —
# 로컬에서는 파일이 디스크에 남아 통과했고, 깨끗한 러너에서만 드러났다.
packages/*
!packages/contracts/
!packages/evaluator/
!packages/kiosk-driver-contract/
!packages/participant-sdk/
!packages/profile-contract/
!packages/safety-engine/
!packages/simulation-driver/
!packages/state-engine/
!packages/uprlite-driver-contract/
environments/*
!environments/chicken-store/
