{
  "version": "1.0.0",
  "environmentId": "public-office",
  "title": "신청 안내 내용",
  "notice": "실제 민원 신청과 본인확인이 수행되지 않았습니다. 시뮬레이션 검토 화면입니다.",
  "fields": [
    {
      "fieldId": "serviceCategory",
      "label": "민원 카테고리",
      "required": true,
      "sources": [
        {
          "type": "selectedOption",
          "key": "CATEGORY"
        },
        {
          "type": "selectedCandidateSupportedOption",
          "key": "CATEGORY",
          "strategy": "FIRST"
        },
        {
          "type": "sessionContext",
          "path": "facts.serviceCategory"
        }
      ],
      "valueLabels": {
        "RESIDENT": "주민",
        "FAMILY": "가족관계",
        "INSURANCE": "보험",
        "TAX": "세무",
        "STAFF": "직원 도움",
        "UNKNOWN": "카테고리 확인 필요"
      }
    },
    {
      "fieldId": "requestedTask",
      "label": "요청 업무",
      "required": true,
      "sources": [
        {
          "type": "sessionContext",
          "path": "intent.task"
        },
        {
          "type": "constant",
          "value": "PUBLIC_SERVICE_GUIDANCE"
        }
      ],
      "valueLabels": {
        "PUBLIC_SERVICE_GUIDANCE": "민원 안내"
      }
    },
    {
      "fieldId": "selectedService",
      "label": "선택된 서비스",
      "required": true,
      "sources": [
        {
          "type": "selectedCandidateField",
          "key": "name"
        }
      ]
    },
    {
      "fieldId": "authMethod",
      "label": "인증수단",
      "required": true,
      "sources": [
        {
          "type": "selectedOption",
          "key": "AUTH_METHOD"
        },
        {
          "type": "selectedCandidateRequirement",
          "key": "authenticationMethods",
          "strategy": "INTERSECTION_SINGLE"
        }
      ],
      "valueLabels": {
        "MOBILE_AUTH": "모바일 인증",
        "ID_CARD": "신분증",
        "STAFF_ASSIST": "직원 확인",
        "UNKNOWN": "인증수단 확인 필요"
      }
    },
    {
      "fieldId": "availableAuthMethods",
      "label": "이용 가능한 인증수단",
      "required": true,
      "sources": [
        {
          "type": "sessionContext",
          "path": "capabilities.availableAuthMethods",
          "strategy": "JOIN",
          "separator": ", ",
          "itemValueLabels": {
            "MOBILE_AUTH": "모바일 인증",
            "ID_CARD": "신분증",
            "STAFF_ASSIST": "직원 도움",
            "NONE": "사용 가능한 인증수단 없음",
            "UNKNOWN": "인증수단 확인 필요",
            "BIOMETRIC": "생체 인증"
          }
        }
      ],
      "fallbackLabel": "확인 필요"
    },
    {
      "fieldId": "guidanceMode",
      "label": "안내 방식",
      "sources": [
        {
          "type": "sessionContext",
          "path": "preferences.stepByStep"
        }
      ],
      "valueLabels": {
        "true": "단계별 안내",
        "false": "일반 안내"
      },
      "fallbackLabel": "일반 안내"
    },
    {
      "fieldId": "accessibility",
      "label": "접근성 설정",
      "sources": [
        {
          "type": "sessionContext",
          "path": "preferences.simpleLanguage"
        }
      ],
      "valueLabels": {
        "true": "쉬운 문장",
        "false": "기본 문장"
      },
      "fallbackLabel": "기본 문장"
    },
    {
      "fieldId": "notActualApplication",
      "label": "안내",
      "required": true,
      "sources": [
        {
          "type": "constant",
          "value": "실제 민원 신청이 아닙니다 (시뮬레이션)"
        }
      ]
    }
  ]
}