// ══════════════════════════════════════════════════════════════════════
// 이 파일은 설명용입니다.
// JSONC 주석이 있으므로 API 에 직접 제출하지 마세요 (JSON 파싱 실패).
// 실행 예제는 ../submission-format-example/sandbox.json 을 사용하세요.
// ══════════════════════════════════════════════════════════════════════

// Recommendation — "무엇을 왜 권하는가"
//
// 누가 만드나: 참가팀 (STEP 5·6·7)
// 공식 3환경에서는 이 내용을 아무도 알려주지 않습니다. 여러분이 만들 결과물입니다.
{
  // [필수] 1순위 후보 ID. fixture.candidates 에 실제로 있어야 합니다.
  //        없으면 CANDIDATE_NOT_FOUND, 품절이면 CANDIDATE_UNAVAILABLE.
  "recommendedCandidateId": "<후보ID>",

  // [필수] 대안. 1순위가 사용자의 뜻과 다를 때 돌아갈 길입니다.
  //        대안도 hardConstraints 를 지켜야 합니다.
  "alternativeCandidateIds": [],

  // [필수] 왜 뺐는가. 화면에서 "이건 왜 없나요?" 에 답할 수 있게 합니다.
  "excludedCandidates": [
    // { "candidateId": "<후보ID>", "reason": "등록하신 알레르기와 겹칩니다" }
  ],

  // [필수] 점수 내역. 설계는 전적으로 여러분의 몫이며 심사 대상입니다.
  "scoreBreakdown": {},

  // [필수] 최소 1개. 사용자가 읽을 문장으로 쓰세요.
  //   나쁨: "AI가 추천했습니다" · "최적의 선택입니다"
  //   좋음: "포장을 선호하셔서 포장 가능한 메뉴를 먼저 보여드렸습니다"
  //         "지금 비가 내려 따뜻한 메뉴를 앞에 두었습니다"
  //   외부 맥락을 썼다면 그 이유도 한 줄 넣으세요.
  "recommendationReasons": ["<사용자가 읽을 이유>"],

  // [필수] 만족시키지 못한 조건
  "unmetConditions": [],

  // [필수] 0~1
  "confidence": 0.9,

  // [필수] 확신이 낮으면 true. 사용자에게 다시 물어보세요.
  "requiresReconfirmation": false
}
