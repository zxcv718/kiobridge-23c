// ══════════════════════════════════════════════════════════════════════
// 이 파일은 설명용입니다.
// JSONC 주석이 있으므로 API 에 직접 제출하지 마세요 (JSON 파싱 실패).
// 실행 예제는 ../submission-format-example/sandbox.json 을 사용하세요.
// ══════════════════════════════════════════════════════════════════════

// UserDecision — "사용자가 실제로 승인했는가"
//
// 누가 만드나: 참가팀 (STEP 8) — 단, 값은 반드시 사용자에게서 나와야 합니다
//
// 자동 추천을 자동 실행으로 잇지 마세요.
// 추천 → 이유 표시 → 대안 표시 → 수정 가능 → 최종 확인 → 여기
{
  // [필수] false 인데 executionPlan.actions 가 비어 있지 않으면
  //        ACTIONS_WITHOUT_APPROVAL 로 거부됩니다.
  "approved": true,

  // [필수] APPROVE · REJECT · MODIFY
  "decision": "APPROVE"

  // [선택] 넣는다면 UTC ISO 8601 (대문자 Z).
  //        "2026-08-03T00:11:00" 처럼 시간대가 없으면 INVALID_UTC_TIMESTAMP.
  // "confirmedAt": "2026-08-03T00:11:00Z",

  // [선택] 사용자가 남긴 메모
  // "note": "..."
}
